{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": ["/postgresql:\\/\\/local_user:local_password@localhost:5432\\//"]
          }
        }
      ]
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "JWT_SECRET preenchido",
            "pattern": "/^[ \\t]*JWT_SECRET[ \\t]*=[ \\t]*(?!replace-with-)[^\\s#]+/m",
            "message": "JWT_SECRET não pode ser commitado com valor preenchido (use o placeholder do .env.example)."
          },
          {
            "name": "SMTP_PASSWORD preenchido",
            "pattern": "/^[ \\t]*SMTP_PASSWORD[ \\t]*=[ \\t]*[^\\s#]+/m",
            "message": "SMTP_PASSWORD não pode ser commitado com valor preenchido."
          }
        ]
      }
    }
  ]
}
