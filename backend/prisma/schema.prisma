generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER

  @@map("role")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELED

  @@map("order_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  // Normalizado (trim + minúsculas) pela aplicação antes de gravar.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("users")
}

enum CustomerType {
  // Documento é CPF.
  PERSON
  // Documento é CNPJ.
  COMPANY

  @@map("customer_type")
}

model Customer {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(150)
  // CPF (11) ou CNPJ (14) sem pontuação. CHECK de formato x tipo na migration.
  document    String       @unique @db.VarChar(14)
  // Definido pela aplicação a partir do documento.
  type        CustomerType
  // Pedidos ativos (deletedAt nulo). CHECK >= 0 na migration.
  ordersCount Int          @default(0) @map("orders_count")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("customers")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  // Único também entre pedidos excluídos logicamente.
  orderNumber          String      @unique @map("order_number") @db.VarChar(50)
  expectedDeliveryDate DateTime    @map("expected_delivery_date") @db.Date
  deliveryAddress      String      @map("delivery_address") @db.VarChar(500)
  status               OrderStatus @default(PENDING)
  customerId           String      @map("customer_id") @db.Uuid
  createdById          String      @map("created_by_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz(3)

  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     OrderItem[]

  // Listagem: ordenação por createdAt desc com id como desempate.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status])
  @@index([customerId])
  @@index([createdById])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  description String  @db.VarChar(255)
  // CHECK >= 0 na migration.
  price       Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}
