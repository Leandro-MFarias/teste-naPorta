# Copie para .env.development (ou .env.<NODE_ENV>) e ajuste os valores.
# Nunca versione arquivos .env.

# development | test | production
NODE_ENV=development
PORT=3333

# Porta publicada pela API no Docker Compose (npm run docker:up).
API_PORT=3333

# Banco local (container do compose.yaml)
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
POSTGRES_DB=local_db
POSTGRES_PORT=5432

# Deve corresponder aos valores POSTGRES_* acima
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/local_db?schema=public

# Obrigatório, mínimo de 32 caracteres. Gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Formato <número><s|m|h|d>. Mínimo: 5h.
JWT_EXPIRES_IN=5h

# Origens (sites) que podem chamar a API pelo navegador, separadas por
# vírgula, sem caminho. Padrão: o frontend Next.js local.
# Ex.: CORS_ORIGINS=http://localhost:3000,https://portal.naporta.com.br
CORS_ORIGINS=http://localhost:3000
